# Unreal Engine generated directories
/Binaries/
/Build/
/DerivedDataCache/
/Intermediate/
/Saved/

# Generated files inside project plugins
/Plugins/**/Binaries/
/Plugins/**/Intermediate/
/Plugins/**/DerivedDataCache/
/Plugins/**/Saved/

# Per-user Unreal content
/Content/Developers/

# Visual Studio and VS Code
/.vs/
/.vscode/
**/.history/
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb
*.opendb
*.opensdf
*.sdf

