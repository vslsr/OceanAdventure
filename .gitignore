*.pdb
*.obj
*.ipch
*.iobj
*.ipdb
*.tmp
*.temp
*.bak
*.orig
*.log

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Archives
*.zip

# EOS SDK files supplied outside source control
/Plugins/EOSIntegrationKit/Source/ThirdParty/EIKSDK/Tools/
/Plugins/EOSIntegrationKit/Source/ThirdParty/EIKSDK/Lib/
/Plugins/EOSIntegrationKit/Source/ThirdParty/EIKSDK/Include/
/Plugins/EOSIntegrationKit/Source/ThirdParty/EIKSDK/Bin/

# Local EOS credentials and runtime configuration
/Config/Custom/EosClient/
/Config/Custom/EosDedicatedServer/

# Local MCPmarket credentials
/.agents/plugins/mcpmarket-me/.mcp.json
/.agents/plugins/mcpmarket-me/mcp-servers.toml

# Local MCPmarket credentials
/.agents/plugins/mcpmarket-me/.mcp.json
/.agents/plugins/mcpmarket-me/mcp-servers.toml

# Python bytecode cache
__pycache__/
*.pyc

# Node tooling for the TypeScript scripts. The compiled bundles under
# Plugins/**/Content/Script/ are committed on purpose -- the engine has no Node, so a
# checkout without them has no scripts, and a game with no scripts plays on quietly with
# every rule fallen back to its C++ default. `npm run check:dist` keeps them in step.
/node_modules/
**/node_modules/

# PuerTS, supplied outside source control like the EOS SDK above: it carries prebuilt V8
# binaries far too large for this repository. Tools/setup-puerts.mjs prints how to install it.
/Plugins/Puerts/
/Plugins/PuerTS/

# Typings generated from live reflection by the editor. The hand-written ones under
# Plugins/**/TypeScript/typings/ are committed instead, and checked against the C++ headers
# by `npm run check:api`.
/Plugins/**/TypeScript/typings/generated/
